<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>Stone</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<!-- WKWebView loads Fossil's UI over http://localhost:<port>. Allow it. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<!-- Stone only uses standard HTTPS/TLS (LibreSSL, for Fossil sync),
	     which is exempt from export compliance review. Declaring this
	     stops App Store Connect from asking the encryption question on
	     every build. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- Ticket 1a55c5d8b8: background sync. "fetch" lets iOS wake the app
	     briefly and periodically to run a BGAppRefreshTask (the normal
	     "Sync All" case); "processing" lets it grant a longer-running
	     BGProcessingTask window (e.g. a first sync of a large repo, or
	     several repos in one wake) when the system judges conditions good
	     (charging/Wi-Fi are more likely, but not required). Neither needs
	     an entitlement/capability: these are plain Info.plist keys. See
	     BackgroundSyncScheduler.swift for where both get registered and
	     scheduled. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
		<string>processing</string>
	</array>
	<!-- Every BGTaskScheduler identifier this app submits requests for must
	     be pre-declared here, or BGTaskScheduler.submit(_:) throws at
	     runtime (BGTaskScheduler.h). Must match
	     BackgroundSyncScheduler.refreshTaskIdentifier /
	     .processingTaskIdentifier exactly. -->
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>org.beagleboard.stone.sync-refresh</string>
		<string>org.beagleboard.stone.sync-processing</string>
	</array>
</dict>
</plist>
