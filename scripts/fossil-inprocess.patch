 /*
+** STONE: Reset the delete-on-failure registry to its initial state.
+**
+** db_delete_on_failure() registers a just-created file (e.g. a brand-new
+** repository from "init"/"clone") to be deleted if the CURRENT command
+** fails before committing -- a safety net against leaving a half-created
+** file behind. Nothing in Fossil ever un-registers an entry on success:
+** upstream doesn't need to, since the process always exits right after.
+** In the embedded in-process server (see scripts/fossil-inprocess.patch),
+** a stale entry from an EARLIER, already-successful invocation survives
+** into a LATER, unrelated one -- the next time db_force_rollback() runs
+** for any reason at all, it deletes that earlier file. Reproduced
+** directly by this repository's own regression test
+** (scripts/linux-crosslink-test-driver.c), which lost a freshly-created
+** repository this way before this fix. Called from the top of every
+** fossil_main() (see src/main.c).
+*/
+void db_reset_delete_on_fail(void){
+  int i;
+  for(i=0; i<db.nDeleteOnFail; i++){
+    fossil_free(db.azDeleteOnFail[i]);
+    db.azDeleteOnFail[i] = 0;
+  }
+  db.nDeleteOnFail = 0;
+}
+
+/*
 ** Return the transaction nesting depth.  0 means we are currently
 ** not in a transaction.
 */
