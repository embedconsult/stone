# Writes ios/FossilBridge/StoneWasmHello.h and ios/Stone/Apps/hello/app.wasm
# (Stone's first bundled app, with its release.txt): a tiny wasm32-wasi module, put
# together byte by byte, that writes one CGI response to stdout with WASI's
# fd_write and returns. Stone runs it to show that WAMR works inside the
# app (StoneWasm.h). Run: crystal run scripts/stone-wasm-hello.cr

TEXT = "Content-Type: text/html\r\n\r\n" \
       "<!doctype html><meta name=\"viewport\" content=\"width=device-width\">" \
       "<h1>WebAssembly runs in Stone</h1>" \
       "<p>This page came from a small WebAssembly module shipped inside the app, run by WAMR.</p>"

def uleb(n : Int) : Array(UInt8)
  out = [] of UInt8
  loop do
    byte = (n & 0x7f).to_u8
    n >>= 7
    out << (n == 0 ? byte : byte | 0x80)
    break if n == 0
  end
  out
end

def sleb(n : Int) : Array(UInt8)
  out = [] of UInt8
  loop do
    byte = (n & 0x7f).to_u8
    n >>= 7
    done = (n == 0 && byte & 0x40 == 0) || (n == -1 && byte & 0x40 != 0)
    out << (done ? byte : byte | 0x80)
    break if done
  end
  out
end

def name(s : String) : Array(UInt8)
  uleb(s.bytesize) + s.bytes
end

def section(id : Int, body : Array(UInt8)) : Array(UInt8)
  [id.to_u8] + uleb(body.size) + body
end

def le32(n : Int) : Array(UInt8)
  [n & 0xff, (n >> 8) & 0xff, (n >> 16) & 0xff, (n >> 24) & 0xff].map(&.to_u8)
end

I32 = 0x7f_u8
types = uleb(2) +
        [0x60_u8] + uleb(4) + [I32, I32, I32, I32] + uleb(1) + [I32] + # 0: fd_write
        [0x60_u8] + uleb(0) + uleb(0)                                    # 1: _start
imports = uleb(1) + name("wasi_snapshot_preview1") + name("fd_write") + [0x00_u8] + uleb(0)
functions = uleb(1) + uleb(1)
memory = uleb(1) + [0x00_u8] + uleb(1)
exports = uleb(2) + name("memory") + [0x02_u8] + uleb(0) + name("_start") + [0x00_u8] + uleb(1)
# _start: drop(fd_write(1, 0, 1, 8))
body = [0x00_u8] + # no locals
       [0x41_u8] + sleb(1) + [0x41_u8] + sleb(0) + [0x41_u8] + sleb(1) + [0x41_u8] + sleb(8) +
       [0x10_u8] + uleb(0) + [0x1a_u8, 0x0b_u8]
code = uleb(1) + uleb(body.size) + body
# Memory at 0: one iovec {buf = 16, len}, then nwritten at 8, the text at 16.
image = le32(16) + le32(TEXT.bytesize) + le32(0) + le32(0) + TEXT.bytes
data = uleb(1) + uleb(0) + [0x41_u8] + sleb(0) + [0x0b_u8] + uleb(image.size) + image

wasm = [0x00_u8, 0x61_u8, 0x73_u8, 0x6d_u8, 0x01_u8, 0x00_u8, 0x00_u8, 0x00_u8] +
       section(1, types) + section(2, imports) + section(3, functions) + section(5, memory) +
       section(7, exports) + section(10, code) + section(11, data)

lines = wasm.each_slice(12).map { |row| "    " + row.map { |b| "0x%02x," % b }.join(" ") }
File.write("ios/FossilBridge/StoneWasmHello.h", <<-H)
/* Generated by scripts/stone-wasm-hello.cr; don't edit. A #{wasm.size}-byte
 * wasm32-wasi module that writes one CGI response and returns. */
static const unsigned char stone_wasm_hello[] = {
#{lines.join("\n")}
};

H
puts "ios/FossilBridge/StoneWasmHello.h: #{wasm.size} bytes"
Dir.mkdir_p("ios/Stone/Apps/hello")
File.write("ios/Stone/Apps/hello/app.wasm", Bytes.new(wasm.size) { |i| wasm[i] })
puts "ios/Stone/Apps/hello/app.wasm: #{wasm.size} bytes"
